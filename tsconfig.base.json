{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Workspace packages resolve to TypeScript source (see each package's
    // "exports" map), so relative imports carry an explicit .ts extension.
    // Safe here because nothing is emitted by tsc — Vite and Bun do the
    // transpiling. See docs/PLAN.md M0-1.
    "allowImportingTsExtensions": true,

    // Ambient types are listed explicitly rather than left to whatever @types
    // packages happen to be installed. Everything here runs on Node or Bun, so
    // `node` is the baseline — it is what supplies AbortSignal and friends, since
    // "lib" above deliberately excludes DOM. A package that genuinely needs browser
    // globals (apps/web) widens both "lib" and "types" in its own tsconfig.
    "types": ["node"],

    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  }
}

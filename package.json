{
  "name": "nap",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:worker": "turbo run dev:worker",
    "dev:reaper": "turbo run dev:reaper",
    "build": "turbo run build",
    "test": "vitest run --project unit --project types --project web --project db",
    "test:fast": "vitest run --project unit --project types --project web",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "harness": "bun run packages/runtime/scripts/harness.ts",
    "db:migrate": "bun run packages/db/scripts/migrate.ts",
    "ws:smoke": "bun run apps/api/scripts/ws-smoke.ts",
    "loadgen": "bun run apps/api/scripts/loadgen.ts",
    "loadgen:ramp": "bun run apps/api/scripts/loadgen-ramp.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "lefthook install",
    "napbench": "bun run apps/napbench/scripts/napbench.ts",
    "napbench:preview-spike": "bun run apps/napbench/scripts/preview-reachability.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@nap/agent": "workspace:*",
    "@nap/context": "workspace:*",
    "@nap/sandbox": "workspace:*",
    "@nap/shared": "workspace:*",
    "@nap/verify": "workspace:*",
    "@types/node": "26.1.2",
    "@vitejs/plugin-react": "6.0.5",
    "lefthook": "2.1.10",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

{
  "name": "nap",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run --project unit --project types --project db",
    "test:fast": "vitest run --project unit --project types",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.1.2",
    "lefthook": "2.1.10",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

{
  "query": {
    "query": "with \"expired_requests\" as (\n      select id from \"turn_requests\"\n      where state = 'leased'\n        and lease_expires_at < now() - $1::interval\n      order by lease_expires_at\n      for update skip locked\n      limit $2\n    ) update \"turn_requests\" set \"state\" = $3 where \"turn_requests\".\"id\" in (select \"id\" from \"expired_requests\") returning \"id\", \"session_id\", \"kind\", \"message\"",
    "params": ["30000 milliseconds", 2, "orphaned"]
  },

node_modules/
dist/
.next/
.turbo/
coverage/

# NapBench, retired (tag napbench-v1), wrote its reports, trajectories and screenshots here.
# Checkouts that ran it still hold the directory, which must not show up as untracked.
napbench-results/

# The load harness writes k6 summaries, server samples and reports here, for the same reason.
# What a run *found* belongs in docs/; the megabytes it produced getting there do not.
napload-results/

# `bun run computer:reliability` writes each run's events, screenshots and recording here.
computer-reliability-results/

# Regenerated by `next dev`/`next build`, and it references files under .next/ that a
# fresh clone has not built yet. Typecheck passes without it, so it stays out of the tree.
next-env.d.ts

.env
.env.*
!.env.example

*.log
.DS_Store
.vercel
.env*

# Local scratch notes. Kept out of the tree so a benchmark run can record a clean
# checkout — a funded number is only quotable if the report says which Nap produced it.
.scratch/

# Local drafts made beside the repo (social posts, image prompts). Nothing in the tree writes or
# reads them, and an untracked folder here made the uncommitted-work Stop hook fire every session.
/output/

# NapBench's generated Harbor task registry, from before it was retired (tag napbench-v1).
# Checkouts that generated it still hold it, and it must not show up as untracked.
harbor/tasks/

# Python's build and tool droppings. The lockfile goes with them: nothing reads it — CI pins
# what it needs inline (`ruff@0.9.10`, `harbor>=0.22,<0.23`) rather than resolving from a lock,
# and a committed lock nothing installs from is a file that goes stale unnoticed.
harbor/.venv/
harbor/uv.lock
__pycache__/
.pytest_cache/
.ruff_cache/

# Generated by infra/k8s/{proof,load}/run.sh: the two values the schema forces to be
# credential-shaped. Never checked in — see those overlays' kustomization.yaml.
infra/k8s/*/generated.env

# `scripts/setup-worktree.ts` leaves its setup-running / setup-done / setup-failed markers here.
.t3/

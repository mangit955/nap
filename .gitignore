node_modules/
dist/
.next/
.turbo/
coverage/

# NapBench writes reports, trajectories and screenshots here. Running the benchmark must
# not dirty the tree; the name is stated once, in @nap/bench, and pinned by its test.
napbench-results/

# The load harness writes k6 summaries, server samples and reports here, for the same reason.
# What a run *found* belongs in docs/; the megabytes it produced getting there do not.
napload-results/

# Regenerated by `next dev`/`next build`, and it references files under .next/ that a
# fresh clone has not built yet. Typecheck passes without it, so it stays out of the tree.
next-env.d.ts

.env
.env.*
!.env.example

*.log
.DS_Store
.vercel
.env*

# Local scratch notes. Kept out of the tree so a benchmark run can record a clean
# checkout — a funded number is only quotable if the report says which Nap produced it.
.scratch/

# Generated by infra/k8s/{proof,load}/run.sh: the two values the schema forces to be
# credential-shaped. Never checked in — see those overlays' kustomization.yaml.
infra/k8s/*/generated.env

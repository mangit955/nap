# Copy to .env.local. Both keys are optional — the app runs without them.

# Where the API's WebSocket endpoint lives. Defaults to the port `bun run dev` serves on.
# NEXT_PUBLIC_API_WS_URL=ws://localhost:3001

# Where the API's HTTP endpoints live: creating a session, sending a turn, reading files.
# NEXT_PUBLIC_API_URL=http://localhost:3001

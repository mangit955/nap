# Copy to .env.local. Both keys are optional — the app runs without them.

# Where the API's WebSocket endpoint lives. Defaults to the port `bun run dev` serves on.
# NEXT_PUBLIC_API_WS_URL=ws://localhost:3001

# Temporary. Until the UI can create sessions, this is how the header subscribes to one:
# set it to a row in `sessions` and the connection indicator follows that session's turns.
# Removed by the task that wires turn submission.
# NEXT_PUBLIC_DEV_SESSION_ID=

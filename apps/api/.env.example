# Copy to .env and fill in. The API validates this at boot and refuses to start if
# anything below is missing or malformed, naming every problem at once.

# --- Required now --------------------------------------------------------------
# Matches infra/docker-compose.yml.
DATABASE_URL=postgres://nap:nap@localhost:5432/nap

# The server runs turns itself: it creates E2B sandboxes and calls the model. Required at
# boot, because a process without it only fails on the first message someone sends.
# `bun run test:integration` reads it from this file too.
E2B_API_KEY=

# Which account pays for the model. Only the keys for the platform you pick are required at boot.
# OpenRouter is the default and the route this project uses — one account reaches every model,
# over the same Messages API, so nothing above the LLMProvider seam can tell the difference.
# Get a key at https://openrouter.ai/keys; they look like `sk-or-…`.
#
# NAP_PLATFORM=openrouter
OPENROUTER_API_KEY=

# --- Who is asking ---------------------------------------------------------------
# Signs session cookies. Required: a process that cannot verify its own cookies cannot tell
# who is asking. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# A GitHub OAuth app, if you want the GitHub button. Optional, but both or neither — boot
# refuses one on its own, because half an app fails at the redirect back rather than here.
# Register it with the callback URL http://localhost:3001/api/auth/callback/github
#
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# A Google OAuth app, the same arrangement. Both or neither.
# Register it with the redirect URI http://localhost:3001/api/auth/callback/google
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Whether somebody with no account may look around: a throwaway identity, their own projects,
# the free models and the lower ceilings below. On unless you turn it off.
# NAP_ALLOW_DEMO=true

# Seals the API keys people bring with them, so the database holds nothing anybody can spend.
# Required. 32 bytes of base64 — `openssl rand -base64 32`. Changing it does not corrupt
# anything: every stored key stops opening and everyone falls back to the free models until
# they paste theirs again.
NAP_KEY_ENCRYPTION_SECRET=

# Optional; the defaults shown are what you get if you omit them.
# NAP_WEB_ORIGIN is the one origin allowed through CORS with credentials — it cannot be `*`,
# because a browser will not send a cookie to a wildcard origin. NAP_API_URL is where this
# server is reached, and is what OAuth redirect URIs are built from.
# NAP_WEB_ORIGIN=http://localhost:3000
# NAP_API_URL=http://localhost:3001
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# --- What a turn spends ----------------------------------------------------------
# Every message a user sends is a real model call and a real sandbox. The default is the free
# Laguna demo-trial model, so development and demos run on the same supported free model.
#
# Laguna S 2.1 supports tool calls, which is required for this agent loop.
# Model ids are OpenRouter's, vendor-namespaced. A bare name is assumed to be Anthropic's.
#
# NAP_MODEL=openai/gpt-5.6-luna        # namespaced OpenRouter id; a bare name is read as Anthropic's
#
# Which models a turn may ask for, as a comma-separated list. The picker in the composer is
# built from this, and the turn route refuses anything not named here — an unchecked model id
# from a request body is a stranger choosing what you pay. Must include NAP_MODEL, or the API
# refuses to boot. The default starts with the two free demo-trial models. Every id on it
# supports tool calling, which is not optional — this agent is a tool loop, so a model without
# tools cannot take a single step and every turn on it fails the same way.
# NAP_ALLOWED_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free,openai/gpt-5.6-luna,anthropic/claude-opus-5
# NAP_EFFORT=medium                  # low | medium | high | xhigh | max
# `medium` is the measured default, not a cautious guess: over five prompts it was the cheapest
# and the fastest of medium/high/xhigh, and the app it produced was no worse. Raising it is not
# a straight trade of money for quality — `high` cost 2.3x medium's input tokens while `xhigh`
# cost 1.11x, because what a level really changes is how many times the tool loop goes round.
# NAP_MAX_STEPS=24                   # model calls allowed in one turn
# NAP_CONTEXT_BUDGET_TOKENS=80000    # context assembled per call; a cost limit, not the window

# --- What one person may spend ----------------------------------------------------
# Every turn is a real model call and a real sandbox billed by the second, so an endpoint with no
# ceiling is a bill with no ceiling. The defaults are deliberately tight — a working session is
# five to ten messages, so fifteen an hour is room to work rather than a wall.
#
# NAP_MAX_SANDBOXES_TOTAL is process-wide and is the only one of the three that bounds what
# *everybody together* can spend: per-user limits alone multiply by the number of users.
#
# NAP_TURNS_PER_HOUR=15           # turns one user may start per rolling hour; over this is a 429
# NAP_MAX_SANDBOXES_PER_USER=2    # projects one user may have running at once; over this is a 409
# NAP_MAX_SANDBOXES_TOTAL=10      # running projects across everyone; must be >= the per-user cap

# --- And what a stranger may spend of yours ---------------------------------------
# The three above apply to somebody paying for their own turns, where the ceiling stops a
# runaway loop. These apply to everybody else — the demo visitor and the signed-in person who
# skipped the key step — where the ceiling is the reason the door can be open at all. A free
# model costs no tokens, but every turn is still a sandbox billed by the second.
#
# The deployment pays for demo turns on Luna, bounded by the free-tier rate and sandbox
# ceilings. NAP_FREE_MODEL may be any model on the allowlist — a paid one is intentional
# when you want the demo to run the same model the product uses.
#
# NAP_FREE_TURNS_PER_HOUR=5
# NAP_FREE_MAX_SANDBOXES_PER_USER=1
# NAP_FREE_MODEL=openai/gpt-5.6-luna

# --- Or pay Anthropic directly ----------------------------------------------------
# Set NAP_PLATFORM=anthropic above and fill this in; OPENROUTER_API_KEY is then not required.
# Model ids lose the namespace on this route: `claude-sonnet-5`, not `anthropic/claude-sonnet-5`.
ANTHROPIC_API_KEY=

# --- Or bill it to AWS instead ---------------------------------------------------
# Set NAP_PLATFORM=bedrock above and fill these in; ANTHROPIC_API_KEY is then not required.
# Also used by `bun run harness --real --platform=bedrock` and the Bedrock integration test.
#
# AWS_REGION is not optional for this: the Bedrock client throws at construction without a
# region rather than failing at the first request, and the model must be enabled in that
# region's Bedrock console before any of it works.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=

# --- Where projects live when nothing is running ---------------------------------
# A sandbox is billed by the second and does not survive being idle, so an unused project
# is put away as a git bundle in Cloudflare R2 and restored on the next message. Required:
# a server that can destroy sandboxes but has nowhere to snapshot them is worse than one
# that does neither. Create a bucket (the free tier is ample) and an API token with object
# read/write on it.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- When a project is put away --------------------------------------------------
# NAP_REAP_IDLE_MINUTES must stay below NAP_SANDBOX_TTL_MINUTES, and boot refuses to start
# otherwise. Whichever expires first decides what happens to an idle project: the reaper
# snapshots it before destroying it, and E2B's own timer just deletes it.
#
# NAP_REAP_IDLE_MINUTES=10       # quiet for this long and the project is snapshotted away
# NAP_REAP_INTERVAL_SECONDS=60   # how often to look
# NAP_SANDBOX_TTL_MINUTES=30     # sandbox lifetime, pushed back by every turn

# --- Screenshots for the dashboard's cards -----------------------------------------
# Each project's card shows a picture of the app, taken with a real browser at the end of
# every turn that changed something. Nothing here looks for a browser: unset this and the
# cards fall back to a colour hashed from the project id, which is all they ever had.
#
# NAP_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

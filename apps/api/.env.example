# Copy to .env and fill in. The API validates this at boot and refuses to start if
# anything below is missing or malformed, naming every problem at once.

# --- Required now --------------------------------------------------------------
# Matches infra/docker-compose.yml.
DATABASE_URL=postgres://nap:nap@localhost:5432/nap

# Optional; the defaults shown are what you get if you omit them.
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# --- Read by the integration suite, not by the API -------------------------------
# `bun run test:integration` loads this file and needs this key to talk to real E2B.
# The API itself still creates no sandboxes, so it is deliberately NOT in the boot
# check — that happens in the task where the server first constructs a SandboxManager.
E2B_API_KEY=

# --- Not read yet --------------------------------------------------------------
# Listed so you know what is coming, but deliberately NOT required: a boot check that
# fails on credentials no code uses only teaches people to paste dummy values. Each
# becomes required in the task that first reads it.
#
# ANTHROPIC_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

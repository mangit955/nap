{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "NAP_PLATFORM",
        "NAP_MODEL",
        "NAP_EFFORT"
      ]
    },
    "dev:worker": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "LOG_LEVEL",
        "NODE_ENV",
        "NAP_PLATFORM",
        "NAP_MODEL",
        "NAP_EFFORT",
        "NAP_EVENT_BUS",
        "NAP_WORKER_CONCURRENCY",
        "NAP_DRAIN_TIMEOUT_SECONDS",
        "NAP_CAPTURE_CONCURRENCY",
        "NAP_CHROME_PATH"
      ]
    }
  }
}

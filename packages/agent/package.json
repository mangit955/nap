{
  "name": "@nap/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "native-helper:build": "bun build src/claude-native-helper-main.ts --target=node --outfile=dist/claude-native-helper.mjs",
    "native-helper:smoke": "bun run native-helper:build && bun run src/claude-native-helper-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@anthropic-ai/sdk": "0.116.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nap/shared": "workspace:*",
    "diff": "9.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nap/context": "workspace:*",
    "@nap/sandbox": "workspace:*"
  }
}
